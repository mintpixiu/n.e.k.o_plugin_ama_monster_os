{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mintpixiu/n.e.k.o_plugin_ama_monster_os/docs/system-contract.v1.schema.json",
  "title": "Ama Monster OS system bridge v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "schema_version",
    "api_level",
    "provider",
    "mode",
    "capabilities",
    "reserved",
    "entrypoints"
  ],
  "properties": {
    "contract_id": { "const": "ama.system.bridge" },
    "contract_version": { "const": "1.0.0" },
    "schema_version": { "const": "1.0" },
    "api_level": { "const": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["hosted-plugin", "desktop-builtin"] },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "reserved": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "state": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "pulse", "web_search", "contract"],
      "properties": {
        "context": { "type": "string", "minLength": 1 },
        "pulse": { "type": "string", "minLength": 1 },
        "web_search": { "type": "string", "minLength": 1 },
        "contract": { "type": "string", "minLength": 1 }
      }
    }
  }
}
